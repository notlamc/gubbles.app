# ---------------------------------------------------------------------------
# Gubbles POC environment. Copy to .env and fill in. Never commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# SQLite for local development (relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Canonical public origin. Used for CSRF origin checks and verification QR URLs.
# Production must be the real HTTPS origin.
APP_ORIGIN="http://localhost:3000"

# Secret used to derive QR-digest and card-seed HMAC keys. MUST remain stable for the
# lifetime of stored cards: changing it changes every QR identity and card seed.
GAME_HMAC_SECRET="replace-with-32+-random-bytes"

# Secret for hashing verification codes / recovery codes (HMAC). Rotating invalidates
# outstanding codes only.
AUTH_HMAC_SECRET="replace-with-32+-random-bytes"

# AES-256-GCM key(s) for TOTP secrets at rest: 32 bytes, base64url. The active version
# is TOTP_KEY_VERSION; keep old keys as TOTP_ENCRYPTION_KEY_V<n> while re-encrypting.
TOTP_ENCRYPTION_KEY_V1="replace-with-32-random-bytes-base64url"
TOTP_KEY_VERSION="1"

# Verification-code delivery. "console" prints codes to the SERVER console and is
# refused when NODE_ENV=production. No real provider is wired up in this POC.
DELIVERY_PROVIDER="console"

# Artwork generation: "stub" (deterministic local renderer, NOT AI) or "openai".
ARTWORK_PROVIDER="stub"
ARTWORK_MODEL="gpt-image-1"
ARTWORK_TIMEOUT_MS="90000"
# Only needed when ARTWORK_PROVIDER=openai. Server-side only.
OPENAI_API_KEY=""

# Local filesystem object storage for generated artwork (development adapter).
ASSET_STORAGE_DIR="./.data/assets"

# Set to "1" only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY="0"
